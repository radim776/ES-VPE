	}
	,
	{
		"Name":"Set image",
		"Parameters": [
			{
				"Id":"imgpath",
				"Type":"Str",
				"Required": true,
				"Label":"Path To image file"
			},
			{
				"Id":"picturebox",
				"Type":"Expr",
				"Required": false
			}
		],
		"Code": "%picturebox%.Image=Image.FromFile(%imgpath%)",
		"CustomSubs": ""
	},
	{
		"Name":"Set embedded image",
		"Parameters": [
			{
				"Id": "imgpath",
				"Type": "Str",
				"Required": true,
				"Label":"Filename of embedded image file"
			},
			{
				"Id": "picturebox",
				"Type": "Expr",
				"Required": false
			}
		],
		"Code": "%picturebox%.Image = Image.FromStream(Reflection.Assembly.GetExecutingAssembly().GetManifestResourceStream(%imgpath%))",
		"CustomSubs": ""
	},
	{
		"Name":"remove image",
		"Parameters": [
			{
				"Id": "picturebox",
				"Type": "Expr",
				"Required": true
			}
		],
		"Code": "%picturebox%.Image=Nothing",
		"CustomSubs": ""
	},
	{
		"Name":"Set Image SizeMode",
		"Parameters": [
			{
				"Id": "picturebox",
				"Type": "Expr",
				"Required": true
			},
			{
				"Id": "sizemode",
				"Type": "Select",
				"Required": true,
				"Values": {
					"PictureBoxSizeMode.StretchImage": "Stretch",
					"PictureBoxSizeMode.Zoom": "Zoom",
					"PictureBoxSizeMode.CenterImage": "Center"
				}
			}
		],
		"Code": "%picturebox%.SizeMode=%sizemode%",
		"CustomSubs": ""
	},
	{
