	{
		"Name":"get ResourceStream of embedded file",
		"Parameters":[
			{
				"Id":"filename",
				"Type":"Str",
				"Required":true
			},
			{
				"Id":"savetovar",
				"Type":"Expr",
				"Required":true,
				"Label":"Name of ResourceStream variable"
			}
		],
		"Code":"'here is the event for getting embedded file of %filename% and saving it to s_%savetovar%",
		"CustomSubs":"Dim s_%savetovar%=Reflection.Assembly.GetExecutingAssembly().GetManifestResourceStream(%filename%)"
	},
	{
		"Name":"get Image from ResourceStream",
		"Parameters":[
			{
				"Id":"ResourceStream",
				"Type":"Expr",
				"Required":true
			},
			{
				"Id":"savetovar",
				"Type":"Expr",
				"Required":true,
				"Label":"Name of Image variable"
			}
		],
		"Code":"'here is the event for getting image from resourcestream of %ResourceStream% and saving it to i_%savetovar%",
		"CustomSubs":"Dim i_%savetovar% As Image= Image.FromStream(s_%ResourceStream%)"
	},
