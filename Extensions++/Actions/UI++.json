	{
		"Name":"Set font",
		"Parameters": [
			{
				"Id": "control",
				"Type": "Expr",
				"Required": true
			},
			{
				"Id": "fontname",
				"Type": "Str",
				"Required": false,
				"Default": "Arial"
			},
			{
				"Id": "fontsize",
				"Type": "Num",
				"Required": false,
				"Default": 12.0
			},
			{
				"Id": "fontstyle",
				"Type": "Select",
				"Required": false,
				"Default": "FontStyle.Regular",
				"Values": {
					"FontStyle.Regular": "Regular",
					"FontStyle.Bold": "Bold",
					"FontStyle.Italic": "Italic",
					"FontStyle.Underline": "Underline",
					"FontStyle.Strikeout": "Strikeout"
				}
			}
		],
		"Code": "%control%.Font=New Font(%fontname%,%fontsize%,%fontstyle%)",
		"CustomSubs": ""
	},
	{
		"Name":"set control Size",
		"Parameters": [
			{
				"Id": "control",
				"Type": "Expr",
				"Required": false
			},
			{
				"Id": "width",
				"Type": "Expr",
				"Required": true
			},
			{
				"Id": "height",
				"Type": "Expr",
				"Required": true
			}
		],
		"Code": "%control%.Size = New Size(%width%, %height%)",
		"CustomSubs": ""
	},
